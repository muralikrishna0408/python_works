#Variable Scope (Local vs Global)
#Global: A variable defined in a program (outside of a function)
a=100#Global variable, exists across this notebook/module
#Local variable: A variable defined inside a function has only scope within the function.
b=10#Global
c=20#Global
def fun1():
    b=200#Local
    global c
    c=300#Override the global variable defined outside of this function
fun1()
print(b)#prints global value of 10 rather than local value of 200
print(c)#prints global value of 300 by overriding the global value of 20

