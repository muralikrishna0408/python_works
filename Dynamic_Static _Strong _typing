#Dynamic inference - based on the assigned value to a variable data type identified dynamically
>>> weight=77.7
>>> print(type(weight))
<class 'float'>
>>> height=6
>>> print(type(height))
<class 'int'>
>>>


#Dynamically typed (Duck type): If a variable is created with a specific data type, can be changed later

>>> height=height+.5
>>> print(type(height))
<class 'float'>
>>>

